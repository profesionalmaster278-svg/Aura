rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.uid is string && data.email is string && data.uid == request.auth.uid;
    }

    function isValidConsultation(data) {
      return data.ticketId is string &&
             data.ticketId.size() <= 64 &&
             data.userId is string &&
             data.userId == request.auth.uid &&
             data.clientName is string &&
             data.clientName.size() <= 100 &&
             data.faceShape is string &&
             data.faceShape.size() <= 50 &&
             data.selectedStyleName is string &&
             data.selectedStyleName.size() <= 120;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(request.resource.data);
      allow delete: if isOwner(userId) && isValidId(userId);

      match /consultations/{consultationId} {
        allow get: if isOwner(userId) && isValidId(consultationId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(consultationId) && isValidConsultation(request.resource.data);
        allow update: if isOwner(userId) && isValidId(consultationId) && isValidConsultation(request.resource.data);
        allow delete: if isOwner(userId) && isValidId(consultationId);
      }
    }
  }
}
